#!/usr/bin/env bash
# Type text into the focused window.
# Usage: x11-type [--display :1] [--delay 12] <text>
set -euo pipefail

DISPLAY_VAL="${X11_DISPLAY:-:1}"
DELAY=12  # ms between keystrokes

while [[ $# -gt 0 ]]; do
  case "$1" in
    --display) DISPLAY_VAL="$2"; shift 2 ;;
    --delay)   DELAY="$2"; shift 2 ;;
    *)         break ;;
  esac
done

TEXT="${1:?text required}"
DISPLAY="$DISPLAY_VAL" xdotool type --delay "$DELAY" -- "$TEXT"
echo "typed: $TEXT"
